node_modules/
dist/

# Built into the Docker context by `npm run build:box`. Derived from src/, so neither is source —
# but the image build needs both present, which is why `scripts/control-up.sh` builds before it
# builds the image.
#
# hostd.mjs used to be committed while boxd.cjs was ignored. That inconsistency was not a decision:
# a 700KB build artefact in the repository can diverge from src/ silently, and it did — a box came
# up answering 404 to /api/usage because the committed bundle predated the endpoint, which read as a
# control-plane bug rather than a stale image.
docker/box/boxd.cjs
docker/box/hostd.mjs

*.log
*.webp
.DS_Store
# Local research notes at the repo root. Nested `research/` dirs inside
# vendored skill packages (catalog-data) are source and must be committed.
/research/
/dist-app/
/design/

# Build output: copied beside the bundle by scripts/copy-catalog-data.mjs.
# The source of truth is src/host/catalog-data.
docker/box/catalog-data/
dist/catalog-data/
