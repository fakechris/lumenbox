{
  "name": "agentbox",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent orchestrator with a remote Docker box and Linux computer-use",
  "type": "module",
  "bin": {
    "agentbox": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:boxd",
    "build:hostd": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=docker/box/hostd.mjs && node scripts/copy-catalog-data.mjs",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/cli.js && node scripts/copy-catalog-data.mjs",
    "build:boxd": "esbuild src/boxd/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=docker/box/boxd.cjs",
    "build:box": "npm run build:boxd && npm run build:hostd",
    "build:image": "npm run build:box && node scripts/build-image.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test-floor.mjs",
    "test:raw": "node --experimental-transform-types --test --test-timeout=30000 'src/**/*.test.ts'",
    "agentbox": "node --experimental-transform-types src/cli.ts",
    "smoke": "node --experimental-transform-types scripts/smoke.mjs",
    "lint": "biome lint src/ scripts/",
    "lint:fix": "biome lint --write src/ scripts/",
    "test:ci": "node scripts/test-floor.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:ci",
    "app": "electron .",
    "dist:app": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release:check": "npm run check && npm run build && node scripts/release-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.10.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/fakechris/lumenbox.git"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.lumenbox.app",
    "productName": "LumenBox",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**",
      "src/**",
      "assets/**",
      "package.json",
      "!src/**/*.test.ts"
    ],
    "mac": {
      "icon": "assets/app-icon/lumenbox.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/app-icon/lumenbox.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/app-icon/png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "LumenBox"
    },
    "dmg": {
      "title": "LumenBox ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
