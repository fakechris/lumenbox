#!/usr/bin/env bash
# Brings up one independent desktop, numbered, and repairs one that is half up.
#
# Each agent gets its own X display rather than sharing one. On a shared display X
# delivers synthetic input to whichever window has focus, so two agents typing at
# once interleave into the wrong window and each screenshots the other's work —
# and a human trying to use the desktop competes with both. Separate displays make
# that impossible instead of merely discouraged, and let the user drive any agent's
# screen while the others keep working.
#
# Everything is per-display and derived from the index: X display :N, VNC on
# 5900+N, noVNC on 6080+N.
#
# Idempotent per component, not just per display. This used to return early if X was
# up, which meant a desktop whose x11vnc had died could never be repaired — the user
# saw a dead screen and the only fix was recreating the container. Each component is
# now checked and started on its own, so re-running this is also how boxd repairs a
# desktop (see src/boxd/displays.ts).
#
# Logs are opened in append mode because boxd truncates them in place when they grow
# too large; with truncation and a non-appending writer, the file would come back full
# of holes at the writer's old offset.
set -euo pipefail

N="${1:?usage: start-display <index>}"
WIDTH="${DISPLAY_WIDTH:-1280}"
HEIGHT="${DISPLAY_HEIGHT:-800}"

DISP=":${N}"
RFB_PORT=$((5900 + N))
WS_PORT=$((6080 + N))

log() { printf '[display %s] %s\n' "$N" "$*"; }

# What this run had to start. Empty output means the desktop was already healthy,
# which is what lets boxd log repairs without logging every health check.
repaired=()

port_listening() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3<&- 2>/dev/null; return 0; }
  return 1
}

# A process matching the pattern whose own DISPLAY is this desktop's. The environ
# check is what makes it per-display: pgrep alone would find another agent's copy.
#
# Two variants because -f matches the whole command line, which also matches anything
# that merely mentions the name — a log tail, or the very command doing the checking.
# For a plain binary, matching the process name exactly is both cheaper and correct.
running_exact() {
  local name="$1" pid
  for pid in $(pgrep -x -- "${name}" 2>/dev/null || true); do
    if tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null | grep -Fqx "DISPLAY=${DISP}"; then
      return 0
    fi
  done
  return 1
}

running_here() {
  local pattern="$1" pid
  for pid in $(pgrep -f -- "${pattern}" 2>/dev/null || true); do
    [ "${pid}" = "$$" ] && continue
    if tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null | grep -Fqx "DISPLAY=${DISP}"; then
      return 0
    fi
  done
  return 1
}

# ── X ────────────────────────────────────────────────────────────────────────────
# +extension GLX +render: Chromium and GTK check for them, and without them they fall
# back to slower paths and log errors an agent then has to reason about.
if ! xdpyinfo -display "${DISP}" > /dev/null 2>&1; then
  log "starting Xvfb at ${WIDTH}x${HEIGHT}"
  # setsid so these outlive this script and are reparented to the container's init
  # rather than dying with the shell boxd spawned us from.
  setsid Xvfb "${DISP}" -screen 0 "${WIDTH}x${HEIGHT}x24" -ac -noreset \
    +extension RANDR +extension GLX +render >> "/tmp/xvfb-${N}.log" 2>&1 &

  for _ in $(seq 1 80); do
    xdpyinfo -display "${DISP}" > /dev/null 2>&1 && break
    sleep 0.25
  done
  if ! xdpyinfo -display "${DISP}" > /dev/null 2>&1; then
    log "FATAL: Xvfb did not come up"
    tail -20 "/tmp/xvfb-${N}.log" >&2 || true
    exit 1
  fi
  repaired+=("Xvfb")
fi

export DISPLAY="${DISP}"

# A visible pointer and readable text. The default cursor is a 16px X11 relic, which
# over VNC is genuinely hard to find on a 1280x800 screen.
printf '%s\n' "Xcursor.theme: Adwaita" "Xcursor.size: 24" "Xft.dpi: 96" \
  "Xft.antialias: 1" "Xft.hinting: 1" "Xft.rgba: rgb" | xrdb -merge 2>/dev/null || true

# ── window manager ───────────────────────────────────────────────────────────────
# Not optional: without one, dialogs open unmapped and keyboard focus never lands, so
# typing silently goes nowhere. Compositing off so the desktop background is visible —
# xfwm4's own compositor paints over the root window.
if ! wmctrl -m > /dev/null 2>&1; then
  log "starting window manager"
  setsid dbus-launch --exit-with-session xfwm4 --replace --compositor=off \
    >> "/tmp/xfwm4-${N}.log" 2>&1 &
  for _ in $(seq 1 40); do
    wmctrl -m > /dev/null 2>&1 && break
    sleep 0.25
  done
  repaired+=("xfwm4")
fi

# ── compositor ───────────────────────────────────────────────────────────────────
# Needed for the dock: without alpha compositing every window owns its pixels on the
# shared framebuffer, so a translucent dock cannot exist. xrender rather than glx —
# there is no GPU in a container — and vsync, frame pacing and damage tracking are all
# off: there is no monitor to sync to, and damage tracking is what goes wrong here.
#
# Not --no-frame-pacing: that is picom 10, and Debian 12 ships 9.1, which rejects the
# flag and prints its usage instead of starting. Copying a flag list written for a newer
# picom is what produced that — a compositor that was never running, while
# the dock silently skipped itself for the same reason.
if ! running_exact "picom"; then
  log "starting compositor"
  setsid picom --backend xrender --no-vsync --no-use-damage \
    >> "/tmp/picom-${N}.log" 2>&1 &
  # Give it a moment to take the selection, or the dock below will decline to start.
  wait-compositor "${DISP}" > /dev/null 2>&1 || true
  repaired+=("picom")
fi

# Painted before anything can look at the screen. A fresh Xvfb root window is black,
# and a black first frame is indistinguishable from a broken desktop.
xsetroot -solid "#141a26" 2>/dev/null || log "could not set the background"

# One workspace. xfwm4 defaults to four and switches on a mouse wheel over the
# desktop, so a stray scroll would swap the screen for an empty one — which a
# person notices and an agent does not.
wmctrl -n 1 2>/dev/null || log "could not set the workspace count"

# ── GTK settings with no config-file equivalent ──────────────────────────────────
# The GTK3 file chooser opens at the size remembered in dconf, and with nothing
# remembered it falls back to roughly 1124x822 — taller than this screen. Open and
# Cancel then sit below the bottom edge, where computer-use cannot click them and a
# person has to resize the dialog first. GTK3 ignores max-height on a toplevel, so
# dconf is the only lever. dbus-run-session because dconf writes go through a session
# bus; the value still lands in ~/.config/dconf/user and outlives the temporary bus.
if command -v dconf > /dev/null 2>&1; then
  if [ "$(dconf read /org/gtk/settings/file-chooser/window-size 2>/dev/null)" != "(1100, 680)" ]; then
    dbus-run-session -- sh -c '
      dconf write /org/gtk/settings/file-chooser/window-size "(1100, 680)"
      dconf write /org/gtk/settings/file-chooser/window-position "(90, 60)"
    ' 2>/dev/null || log "could not pre-seed the GTK file chooser size"
  fi
fi

# Dock preferences, which plank keeps in dconf rather than in a file.
if command -v dconf > /dev/null 2>&1; then
  if [ "$(dconf read /net/launchpad/plank/docks/dock1/theme 2>/dev/null)" != "'Transparent'" ]; then
    dbus-run-session -- sh -c "
      p=/net/launchpad/plank/docks/dock1
      dconf write \$p/dock-items \"['chromium.dockitem', 'files.dockitem', 'terminal.dockitem']\"
      dconf write \$p/position \"'bottom'\"
      dconf write \$p/theme \"'Transparent'\"
      dconf write \$p/icon-size 48
      dconf write \$p/hide-mode \"'none'\"
    " 2>/dev/null || log "could not write the dock preferences"
  fi
fi

# ── clipboard ────────────────────────────────────────────────────────────────────
# X has two selections and applications disagree about which one holds "the clipboard":
# PRIMARY is what a middle-click pastes, CLIPBOARD is what Ctrl-V pastes. autocutsel
# keeps them in step, in both directions, which is what makes a copy in one application
# paste into another — and what makes the VNC clipboard carry the thing the user
# actually copied rather than whichever selection happened to be set.
for selection in PRIMARY CLIPBOARD; do
  if ! running_here "autocutsel -selection ${selection}"; then
    setsid autocutsel -selection "${selection}" -fork \
      >> "/tmp/autocutsel-${N}.log" 2>&1 &
    repaired+=("autocutsel(${selection})")
  fi
done

# ── desktop icons ────────────────────────────────────────────────────────────────
if ! running_here "pcmanfm --desktop"; then
  log "starting desktop icons"
  setsid pcmanfm --desktop --profile default >> "/tmp/pcmanfm-${N}.log" 2>&1 &
  repaired+=("pcmanfm")
fi

# ── dock ─────────────────────────────────────────────────────────────────────────
# Started only once a compositor owns the display. plank reads that once, at startup,
# and paints an opaque slab forever if the answer was no — so "picom was spawned" is not
# good enough, and wait-compositor waits for it to actually own _NET_WM_CM_S0.
if ! running_exact "plank"; then
  if wait-compositor "${DISP}"; then
    log "starting dock"
    setsid plank >> "/tmp/plank-${N}.log" 2>&1 &
    repaired+=("plank")
  else
    log "no compositor on ${DISP}; skipping the dock rather than drawing an opaque one"
  fi
fi

# ── VNC ──────────────────────────────────────────────────────────────────────────
# -localhost: only boxd reaches these, and it is the only thing published.
# -capslock so a Caps Lock left on by synthetic input does not silently upcase
# everything typed afterwards.
# -noxdamage is not an optimisation to skip: x11vnc learns what changed from XDamage,
# and damage reported against the root window misses a composited repaint, so the viewer
# sits on a stale frame while X, the agent and the screenshots all look healthy. Polling
# the whole framebuffer is reliable and cheap — Xvfb keeps it in RAM. vnc-probe checks
# that this is actually working rather than merely configured.
if ! port_listening "${RFB_PORT}"; then
  log "starting x11vnc on ${RFB_PORT}"
  setsid x11vnc -display "${DISP}" -forever -shared -nopw -quiet -localhost \
    -capslock -noxdamage -rfbport "${RFB_PORT}" >> "/tmp/x11vnc-${N}.log" 2>&1 &
  repaired+=("x11vnc")
fi

# --heartbeat: a WebSocket with no traffic gets closed by intermediaries, and the
# symptom is a desktop that goes blank and reconnects while nothing is wrong.
if ! port_listening "${WS_PORT}"; then
  log "starting noVNC on ${WS_PORT}"
  setsid websockify --heartbeat=30 --web=/usr/share/novnc \
    "${WS_PORT}" "localhost:${RFB_PORT}" >> "/tmp/novnc-${N}.log" 2>&1 &
  repaired+=("websockify")
fi

# Wait for the VNC path, not just X: boxd reports the display ready and the UI
# connects immediately, so a half-started stack shows as a failed connection.
for _ in $(seq 1 60); do
  if port_listening "${WS_PORT}"; then
    if [ ${#repaired[@]} -gt 0 ]; then
      log "ready (started: ${repaired[*]})"
    fi
    exit 0
  fi
  sleep 0.25
done

log "WARNING: noVNC on ${WS_PORT} did not start; the desktop will not be viewable"
exit 0
