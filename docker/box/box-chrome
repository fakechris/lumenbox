#!/usr/bin/env bash
# Launches Chromium with the flags a container needs.
#
# Plain `chromium` inside Docker fails in ways that are confusing to an agent
# reading stderr: the setuid sandbox cannot start without extra kernel
# capabilities, and Chromium's shared-memory use exceeds Docker's default 64MB
# /dev/shm even when --shm-size is raised. Both are container facts, not something
# the model should have to rediscover — so the wrapper is the documented entry
# point and the prompt points at it.
set -euo pipefail

# A profile per desktop, because a profile per box is a profile shared between
# agents. Chromium allows one instance per profile directory and refuses the second
# by way of the lock below — so with one shared profile, two agents browsing at once
# either fight over the lock or, once it is cleared, run rival instances writing the
# same profile. Windows then open wherever the surviving instance is connected, which
# is another agent's screen. DISPLAY is what tells the agents apart, so it keys this.
DESKTOP="$(printf '%s' "${DISPLAY:-:0}" | tr -cd '0-9')"
# Priority is inherited, and deliberately not corrected here. A browser launched from the
# agent's shell runs at the agent's priority, behind the desktop; one launched from the dock
# or a desktop icon runs at the desktop's. That split is the right way round — the agent's
# browsing is throughput work, a person's is what they are looking at.
#
# Putting an agent-launched browser back at normal priority would need CAP_SYS_NICE, which
# the container does not have: lowering a nice value is privileged, and `sudo renice` fails
# with "Operation not permitted" even as root. Adding that capability would also allow
# real-time scheduling, which a runaway process could use to starve the host — a bad trade
# for a browser that is a little slower while the agent is compiling.

PROFILE="${CHROME_PROFILE:-$HOME/.config/box-chrome-${DESKTOP:-0}}"
mkdir -p "$PROFILE"

# A profile left locked by a killed browser makes every later launch fail silently.
# Only clear the lock when nothing holds it: a live instance must keep its own, or a
# second launch on the same desktop starts a rival instance instead of handing the
# URL to the window already open there.
if ! pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null 2>&1; then
  rm -f "$PROFILE"/Singleton{Lock,Cookie,Socket} 2>/dev/null || true
fi

# Through the egress proxy when the box has one, so the browser's traffic leaves from the
# relay's network rather than this container's. The bypass list keeps the box's own services
# — boxd, noVNC, anything an agent serves locally — off the proxy, which would otherwise send
# a loopback request out to the relay and back.
# The semantic browser tools drive this through the DevTools protocol, which needs a
# debugging port. One per desktop, matching the profile split above, so two agents
# browsing at once cannot drive each other's windows.
#
# It binds to loopback *inside the container* and is never published to the host: boxd is
# the only thing that connects to it, and boxd is already authenticated. Publishing it
# would be a second way into the box that answers to nobody, since CDP has no auth of its
# own — anyone who can reach the port owns the browser.
#
# It does mean anything running in the box can drive the browser directly, which is why
# the shell tool refuses commands that try to. Without that, the approval gate on browser
# actions would be advisory.
DEBUG_PORT=$((9222 + ${DESKTOP:-0}))

PROXY_ARGS=()
if [ -n "${AGENTBOX_EGRESS_RELAY:-}" ]; then
  PROXY_ARGS=(
    --proxy-server="http://127.0.0.1:${AGENTBOX_EGRESS_PROXY_PORT:-8791}"
    --proxy-bypass-list="localhost;127.0.0.1;[::1];host.docker.internal"
  )
fi

exec chromium \
  --user-data-dir="$PROFILE" \
  --remote-debugging-port="$DEBUG_PORT" \
  --remote-allow-origins=* \
  "${PROXY_ARGS[@]+"${PROXY_ARGS[@]}"}" \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --no-first-run \
  --no-default-browser-check \
  --disable-features=TranslateUI \
  --window-position=0,0 \
  --start-maximized \
  "$@"
