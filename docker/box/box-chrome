#!/usr/bin/env bash
# Launches Chromium with the flags a container needs.
#
# Plain `chromium` inside Docker fails in ways that are confusing to an agent
# reading stderr: the setuid sandbox cannot start without extra kernel
# capabilities, and Chromium's shared-memory use exceeds Docker's default 64MB
# /dev/shm even when --shm-size is raised. Both are container facts, not something
# the model should have to rediscover — so the wrapper is the documented entry
# point and the prompt points at it.
set -euo pipefail

# A profile per desktop, because a profile per box is a profile shared between
# agents. Chromium allows one instance per profile directory and refuses the second
# by way of the lock below — so with one shared profile, two agents browsing at once
# either fight over the lock or, once it is cleared, run rival instances writing the
# same profile. Windows then open wherever the surviving instance is connected, which
# is another agent's screen. DISPLAY is what tells the agents apart, so it keys this.
DESKTOP="$(printf '%s' "${DISPLAY:-:0}" | tr -cd '0-9')"
PROFILE="${CHROME_PROFILE:-$HOME/.config/box-chrome-${DESKTOP:-0}}"
mkdir -p "$PROFILE"

# A profile left locked by a killed browser makes every later launch fail silently.
# Only clear the lock when nothing holds it: a live instance must keep its own, or a
# second launch on the same desktop starts a rival instance instead of handing the
# URL to the window already open there.
if ! pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null 2>&1; then
  rm -f "$PROFILE"/Singleton{Lock,Cookie,Socket} 2>/dev/null || true
fi

exec chromium \
  --user-data-dir="$PROFILE" \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --no-first-run \
  --no-default-browser-check \
  --disable-features=TranslateUI \
  --window-position=0,0 \
  --start-maximized \
  "$@"
