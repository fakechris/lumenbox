#!/usr/bin/env python3
"""
The desktop's control tree, as JSON, for boxd's `list_elements` (INV-412, docs/49).

Reads the AT-SPI2 accessibility bus of the display in $DISPLAY, finds the active
window, and prints the operable controls in it — role, name, states, screen
rectangle — capped so a busy window is an outline, not a dump. GTK and Qt apps
expose this tree; Chromium does under --force-renderer-accessibility; xterm and most
Electron apps expose nothing, and this says so with an `error` instead of an empty
success, because "no controls" and "cannot see" must never read the same.

Exit codes: 0 with {"window","elements"}; 1 with {"error"} when there is no tree.
Never blocks past the deadline: AT-SPI calls into a hung app can stall, and boxd's
own timeout is the last line, not the first.

Running out of budget is a partial success, not a failure (INV-1481): past the control
limit or the deadline the controls read so far are printed with "complete": false and
the containers whose children were not reached ("truncated": role, name, children_count,
and a "path" of child indices from the window). `--root <path>` reads one such subtree
alone, under the same limit and deadline, and `--ref-prefix <p>` names its refs so they
can join the observation they drill into. Chromium's anonymous wrappers (unnamed panels,
sections, groups) do not count against the node budget, or a web page's reachable
content would be judged by its scaffolding.
"""

import json
import os
import signal
import sys

PERFORM = "--perform" in sys.argv
ATTEMPTED = False
LIMIT = 150
DEADLINE_S = 4
NODE_BUDGET = 5000
WRAPPER_ROLES = {"panel", "filler", "section", "group", "generic", "unknown", "viewport", "scroll pane", "document web", "frame", "canvas", "paragraph"}


def argument(flag, default=None):
    if flag in sys.argv:
        index = sys.argv.index(flag)
        if index + 1 < len(sys.argv):
            return sys.argv[index + 1]
    return default


ROOT_PATH = argument("--root")
REF_PREFIX = argument("--ref-prefix", "a")

# What the walk has read when the deadline cuts it short: printed as a partial observation.
PARTIAL = {"ready": False, "window": None, "elements": [], "truncated": []}

OPERABLE = {
    "push button", "toggle button", "check box", "radio button", "menu", "menu item",
    "check menu item", "radio menu item", "combo box", "entry", "password text", "text",
    "link", "list item", "tree item", "page tab", "slider", "spin button", "tab",
    "table cell", "icon", "button", "search box", "editable text",
}


def fail(reason):
    if PERFORM:
        print(json.dumps({"error": reason, "dispatch": "partial" if ATTEMPTED else "not_started"}))
        sys.exit(0)
    print(json.dumps({"error": reason}))
    sys.exit(1)


def on_alarm(_signum, _frame):
    if PARTIAL["ready"] and not PERFORM:
        # The window is known and some controls are read: say what was seen and where it stopped.
        finish(PARTIAL["window"], PARTIAL["elements"], PARTIAL["truncated"], complete=False)
    fail("the accessibility tree did not answer within %ds" % DEADLINE_S)


if __name__ == "__main__":
    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(DEADLINE_S)
    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
    except Exception as error:  # noqa: BLE001 — any import failure is one answer
        fail("AT-SPI bindings are not available: %s" % error)
else:  # imported by a test: the walk takes duck-typed nodes and never touches the bus
    Atspi = None


def state_names(accessible):
    try:
        states = accessible.get_state_set()
    except Exception:  # noqa: BLE001
        return set()
    names = set()
    for name in ("SHOWING", "VISIBLE", "ENABLED", "SENSITIVE", "FOCUSED", "CHECKED",
                 "SELECTED", "EXPANDED", "EDITABLE", "ACTIVE", "PRESSED"):
        try:
            if states.contains(getattr(Atspi.StateType, name)):
                names.add(name.lower())
        except Exception:  # noqa: BLE001
            pass
    return names


def rect_of(accessible):
    try:
        component = accessible.get_component_iface()
        if component is None:
            return None
        r = component.get_extents(Atspi.CoordType.SCREEN)
        if r.width <= 0 or r.height <= 0:
            return None
        return (r.x, r.y, r.width, r.height)
    except Exception:  # noqa: BLE001
        return None


def x_active_window():
    """Bind X identity and process lifetime, never title alone."""
    import subprocess
    def query(*args):
        result = subprocess.run(["xdotool", *args], capture_output=True, text=True, timeout=2)
        if result.returncode != 0:
            raise RuntimeError("active X window identity unavailable")
        return result.stdout.strip()
    xid = query("getactivewindow")
    pid = int(query("getwindowpid", xid))
    with open("/proc/%d/stat" % pid, encoding="utf-8") as stat:
        # comm may contain spaces and parentheses; field 22 is starttime.
        started = stat.read().rsplit(")", 1)[1].split()[19]
    return {"id": hex(int(xid)), "pid": pid, "started": started,
            "title": query("getwindowname", xid)}


def candidate_windows(target):
    desktop = Atspi.get_desktop(0)
    matches = []
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app is None or app.get_process_id() != target["pid"]:
            continue
        for j in range(app.get_child_count()):
            window = app.get_child_at_index(j)
            if window is not None and (window.get_name() or "") == target["title"]:
                matches.append((app, window))
    return matches


def native_identity(node):
    # Unique D-Bus connection + object path; never a traversal ordinal.
    return "%s:%s" % (node.app.bus_name, node.path)


def invoke_index(node):
    try:
        action = node.get_action_iface()
        if action is None:
            return None
        for i in range(action.get_n_actions()):
            if action.get_action_name(i).lower() in ("click", "press", "activate", "toggle"):
                return i
    except Exception:
        pass
    return None


def operations_of(node, role, states):
    if "enabled" not in states and "sensitive" not in states:
        return []
    try:
        interfaces = {str(i).rsplit(".", 1)[-1] for i in node.get_interfaces()}
    except Exception:
        return []
    operations = []
    if "Action" in interfaces and invoke_index(node) is not None:
        operations.append("invoke")
    if "EditableText" in interfaces and "editable" in states and role in ("entry", "text", "editable text", "search box"):
        operations.append("set_value")
    return operations


def is_wrapper(role, name):
    """An unnamed container that only holds other things: Chromium's layout scaffolding, GTK's boxes."""
    return name == "" and role in WRAPPER_ROLES


def child_count(node):
    try:
        return node.get_child_count()
    except Exception:  # noqa: BLE001
        return 0


def descend(window, path):
    """The node at a child-index path from the window, or None when the path no longer leads anywhere."""
    node = window
    for step in path.split("/") if path else []:
        try:
            node = node.get_child_at_index(int(step))
        except Exception:  # noqa: BLE001
            return None
        if node is None:
            return None
    return node


def walk(root, nodes=None, root_path="", ref_prefix="a", elements=None, truncated=None):
    """
    The operable controls under `root`, top to bottom, until the control limit or the node
    budget. Containers left unread when the walk stops are listed in `truncated` with the
    path a later --root can take to them. `elements` and `truncated` may be passed in so a
    deadline can print what was read so far.
    """
    out = [] if elements is None else elements
    cut = [] if truncated is None else truncated
    # Each stack entry: (node, path of child indices from the window).
    stack = [(root, root_path)]
    seen = 0
    while stack:
        node, path = stack.pop()
        try:
            role = node.get_role_name()
        except Exception:  # noqa: BLE001
            continue
        states = state_names(node)
        try:
            name = node.get_name() or ""
        except Exception:  # noqa: BLE001
            name = ""
        if not is_wrapper(role, name):
            seen += 1
        if seen > NODE_BUDGET or len(out) >= LIMIT:
            # Over budget: this node and everything still on the stack are what was not read.
            for pending, pending_path in [(node, path)] + stack[::-1]:
                count = child_count(pending)
                if count > 0:
                    try:
                        pending_role, pending_name = pending.get_role_name(), (pending.get_name() or "")
                    except Exception:  # noqa: BLE001
                        pending_role, pending_name = "", ""
                    cut.append({"role": pending_role, "name": pending_name[:120], "children_count": count, "path": pending_path})
            break
        if "showing" in states and role in OPERABLE:
            rect = rect_of(node)
            if rect is not None:
                identity = native_identity(node)
                if nodes is not None:
                    nodes[identity] = node
                out.append({
                    "ref": "%s%d" % (ref_prefix, len(out) + 1),
                    "identity": identity,
                    "operations": operations_of(node, role, states),
                    "role": role,
                    "name": name[:120],
                    "x": rect[0], "y": rect[1], "width": rect[2], "height": rect[3],
                    "states": sorted(s for s in states if s in ("checked", "selected", "expanded", "focused", "pressed", "editable"))
                                + ([] if "enabled" in states or "sensitive" in states else ["disabled"]),
                })
        count = child_count(node)
        # Children pushed in reverse so the outline reads top-to-bottom, as the widget tree does.
        for k in range(min(count, 400) - 1, -1, -1):
            child = node.get_child_at_index(k)
            if child is not None:
                stack.append((child, "%s/%d" % (path, k) if path else str(k)))
    return out, cut


def finish(window_info, elements, truncated, complete):
    print(json.dumps({"window": window_info, "elements": elements, "truncated": len(truncated) > 0 or not complete,
                      "complete": complete and len(truncated) == 0, "cut": truncated}))
    sys.exit(0)


def perform(window_identity, xwindow, elements, nodes):
    global ATTEMPTED
    try:
        payload = sys.stdin.buffer.read(65537)
        if len(payload) > 65536:
            fail("native request exceeds its size bound")
        request = json.loads(payload)
        target = request.get("target", {})
        if request.get("window_identity") != window_identity:
            fail("native window identity changed")
        matches = [e for e in elements if e["identity"] == target.get("identity")]
        if len(matches) != 1:
            fail("native target is unavailable or ambiguous")
        current = matches[0]
        if any(current.get(key) != target.get(key) for key in ("role", "name", "x", "y", "width", "height")):
            fail("native target changed since observation")
        operation = request.get("operation")
        if operation not in current["operations"]:
            fail("native operation is unsupported; no coordinate fallback")
        node = nodes[current["identity"]]
        if x_active_window() != xwindow:
            fail("active window changed before native dispatch")
        if operation == "invoke":
            index = invoke_index(node)
            if index is None:
                fail("native action disappeared")
            ATTEMPTED = True
            accepted = node.get_action_iface().do_action(index)
            verification = {"status": "unknown", "source": "none", "detail": "native invoke sent; no postcondition was requested"}
        elif operation == "set_value":
            value = request.get("value")
            if not isinstance(value, str):
                fail("set_value requires a string")
            ATTEMPTED = True
            accepted = node.get_editable_text_iface().set_text_contents(value)
            matches_value = Atspi.Text.get_text(node, 0, node.get_character_count()) == value
            verification = {"status": "satisfied" if matches_value else "unsatisfied", "source": "native", "detail": "native value readback matches" if matches_value else "native value readback differs"}
        else:
            fail("unsupported native operation")
        if not accepted:
            fail("native API did not acknowledge the input; inspect before retrying")
        print(json.dumps({"dispatch": "sent", "verification": verification}))
    except Exception as error:
        # Only the exception class is safe; never values or exception messages.
        fail("native operation or readback failed (%s)" % type(error).__name__)


def main():
    if not os.environ.get("DISPLAY"):
        fail("no DISPLAY")
    try:
        target = x_active_window()
        candidates = candidate_windows(target)
    except Exception as error:
        fail("the active window or accessibility bus is not reachable: %s" % error)
    if not candidates:
        fail("the active window exposes no accessibility tree")
    if len(candidates) != 1:
        fail("ambiguous accessibility window: same process has multiple windows with this title")
    app, window = candidates[0]
    nodes = {} if PERFORM else None
    try:
        identity = "%s:%s:%s:%s" % (target["id"], target["pid"], target["started"], native_identity(window))
        title = window.get_name() or ""
        application = app.get_name() or "" if app is not None else ""
    except Exception as error:
        fail("could not validate the observed window: %s" % error)
    window_info = {"title": title, "app": application, "id": target["id"], "identity": identity}
    root = window
    if ROOT_PATH is not None and not PERFORM:
        root = descend(window, ROOT_PATH)
        if root is None:
            fail("the container at %s is no longer in the window; take a new list_elements" % ROOT_PATH)
    PARTIAL.update({"window": window_info, "ready": not PERFORM})
    elements, truncated = walk(root, nodes, ROOT_PATH or "", REF_PREFIX, PARTIAL["elements"], PARTIAL["truncated"])
    try:
        if x_active_window() != target:
            fail("the active window changed during observation")
    except Exception as error:
        fail("could not validate the observed window: %s" % error)
    if PERFORM:
        perform(identity, target, elements, nodes)
        return
    finish(window_info, elements, truncated, complete=True)


if __name__ == "__main__":
    main()
